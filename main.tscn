[sub_resource type="GDScript" id="GDScript_efxa6"]
resource_name = "Title_Screen_Player"
script/source = "extends CharacterBody2D
#not the actual player script, check player.gd for the actual player script used in gamemodes

@export var MAXIMUM_SPEED = 500.0
@export var ACCELERATION = 1500.0 #how fast the velocity increases to maximum speed 
@export var FRICTION = 80.0 #how fast the velocity decreases to 0 
@export var JUMP_VELOCITY = -250.0

@export var player_animation : AnimatedSprite2D

func  _ready() -> void:
	player_animation.play(\"running\")
	
func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta

	player_animation.speed_scale = velocity.x / 100 + 1
	
	if is_on_floor():
		if Input.is_action_just_pressed(\"ui_left\") or Input.is_action_just_pressed(\"ui_right\"):
			velocity.x = move_toward(velocity.x, MAXIMUM_SPEED * 1, ACCELERATION * delta)
		else:
			velocity.x = move_toward(velocity.x, 100, FRICTION * delta)

	move_and_slide()
"

