[sub_resource type="GDScript" id="GDScript_637q0"]
resource_name = "110 Meter Hurdles"
script/source = "extends Node2D

@export var initiate_music : AudioStream

func _ready() -> void:
	_play_initiate_music()
	
func _play_initiate_music():
	var audio_player = AudioPlayerFunctions.new()
	add_child(audio_player)
	audio_player.play_sound(initiate_music)
"

